{
  "expo": {
    "name": "Penquire",
    "slug": "penquire",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jander.penquire",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Penquire listens while you hold the tutor button (or squeeze your Apple Pencil) so you can ask your tutor a question out loud.",
          "speechRecognitionPermission": "Your question is turned into text on this iPad so the tutor can answer it.",
          "androidSpeechServicePackages": []
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "23f7312e-9e5f-4ec2-b61f-bac160438d2e"
      }
    },
    "owner": "j.andy"
  }
}
