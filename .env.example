# Copy to .env (never commit .env).
# DEV ONLY: this key is bundled into the JS on your device. Before giving the app
# to testers, move AI calls behind the backend proxy (see docs/04-architecture.md).
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides
EXPO_PUBLIC_CHECK_MODEL=claude-sonnet-5-5
EXPO_PUBLIC_PARSE_MODEL=claude-opus-5-5
